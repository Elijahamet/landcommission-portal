{
  "version": 2,
  "functions": {
    "api/index.js": {
      "includeFiles": "node_modules/pdfkit/**"
    },
    "api/*.js": {
      "includeFiles": "node_modules/pdfkit/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/verify/(.*)",
      "destination": "/verify.html"
    },
    {
      "source": "/verify",
      "destination": "/verify.html"
    }
  ]
}

